// condition.mini - if / else and comparison + logical operators
let a = 10;
let b = 20;

if (a < b) {
    print("a is smaller");
} else {
    print("b is smaller");
}

let flag = true;
if (flag && (a != b)) {
    print("flag is true and a is not equal to b");
}

if (a > 100 || b > 15) {
    print("at least one condition is true");
}
